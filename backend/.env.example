# PostgreSQL database connection (falls back to local SQLite if not configured or offline)
DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# Google Gemini API key for grounded LLM answer generation
GEMINI_API_KEY=your_gemini_api_key_here

# LLM model preference (e.g. gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
LLM_MODEL=gemini-2.5-flash

# CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Maximum document upload size in megabytes
MAX_UPLOAD_SIZE_MB=25
